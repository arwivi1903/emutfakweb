RewriteEngine On

# HTTPS zorunlu (üretimde; localhost/127.0.0.1'de devre dışı)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Dizin listelemeyi kapat
Options -Indexes

# Güvenlik başlıkları
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://i.ytimg.com https://img.youtube.com; frame-src https://www.youtube.com; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# Hassas dosyalara erişimi engelle
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "(\.env$|\.env\.|\.sql$|\.md$|composer\.(json|lock)|\.gitignore|\.bak$|\.backup$|~$|\.orig$|\.swp$|\.log$|\.tgz$|\.tar\.gz$|\.DS_Store$)">
    Require all denied
</FilesMatch>
RewriteRule (^|/)\.git(/|$) - [F]

DirectoryIndex index.php index.html

# sitemap.xml -> sitemap.php (arama motorları için)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# /p/ alt panelini bu dosya yönlendirmesin (kendi .htaccess'i yönetir)
RewriteRule ^p/ - [L]

# SEO temiz URL: .php ile biten SORGUSUZ GET isteklerini uzantısıza (301)
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Mevcut dosya/klasörse dokunma
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Uzantısız -> .php
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
