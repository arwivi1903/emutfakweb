# Ortam değişkenleri - ASLA commit edilmez
.env

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*~

# Loglar
*.log
error_log
p/logs/*.log

# Geçici / cache
tmp/
temp/
p/cache/*
!p/cache/.gitignore

# Yedek / dump
*.bak
*.backup
*.sql
*.sql.gz
dump.sql

# Rate-limit / runtime state
p/config/rate_limit/

# Kullanıcı/destek yüklemeleri (çalışma zamanı içeriği, repoya girmez)
uploads/

# Vitrin önbelleği ve performans günlüğü (çalışma zamanı verisi)
cache/*
!cache/.htaccess
logs/*
!logs/.htaccess
