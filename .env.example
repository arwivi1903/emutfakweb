# Prolynweb - Ortam Değişkenleri (ÖRNEK)
# Bu dosyayı ".env" olarak kopyalayın ve gerçek değerleri girin.
# .env dosyası ASLA git'e commit edilmemeli, sunucuda web erişimine kapalı olmalı.

# ==============================================
# ORTAM
# ==============================================
APP_ENV=production
APP_DEBUG=false

# Prolynweb'in yayınlandığı adres (sonunda / OLMADAN)
# Kök dizinde yayınlanıyorsa: https://www.prolyn.net
BASE_URL=https://www.prolyn.net

# Tenant (müşteri paneli) uygulamasının adresi
APP_PANEL_URL=https://app.prolyn.net

# ==============================================
# VERİTABANI (uygulamanın normal bağlantısı)
# Merkezi MySQL sunucusunun adresi. Farklı sunucudaysa iç IP / host girin.
# ==============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prolyn_master
DB_USER=CHANGE_ME_app_user
DB_PASS=CHANGE_ME_strong_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ==============================================
# PROVISIONING (yeni müşteri DB'si + kullanıcısı oluşturan yetkili hesap)
# CREATE DATABASE / CREATE USER / GRANT yetkileri olmalı.
# Uygulamanın normal DB_USER'ından AYRI ve sadece provisioning için kullanılmalı.
# ==============================================
DB_ADMIN_USER=CHANGE_ME_provisioner
DB_ADMIN_PASS=CHANGE_ME_strong_password

# Tenant şablon veritabanının adı (kopyalanacak kaynak)
TENANT_TEMPLATE_DB=prolyn_default
# mysql / mysqldump ikili yolları (boşsa PATH'ten bulunur; Linux'ta genelde boş bırakın)
MYSQL_BIN=
MYSQLDUMP_BIN=

# Tenant MySQL kullanıcılarının erişebileceği host (uygulama sunucusunun IP'si veya %)
TENANT_DB_ALLOWED_HOST=%

# ==============================================
# E-POSTA (SMTP)
# ==============================================
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=CHANGE_ME
MAIL_PASS=CHANGE_ME
MAIL_FROM=noreply@prolyn.net
MAIL_FROM_NAME=Prolyn

# ==============================================
# GÜVENLİK
# ==============================================
# Şifreleme için 32+ karakter rastgele anahtar (openssl rand -hex 32)
APP_KEY=CHANGE_ME_random_64_hex
# Kayıt formu IP başına saatlik limit
REGISTER_RATE_LIMIT=5

# Vitrin önbellek süresi (sn). Varsayılan 300 (5 dk); 0 = kapalı. localhost/127.0.0.1 üzerinde her zaman kapalıdır.
SITE_CACHE_TTL=300
