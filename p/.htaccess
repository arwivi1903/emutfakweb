Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Hassas dosyalara erişimi engelle
<FilesMatch "(\.env$|\.sql$|\.md$|\.bak$|\.backup$|~$|\.orig$|\.swp$|\.log$|\.tgz$|\.tar\.gz$|\.DS_Store$)">
    Require all denied
</FilesMatch>
RewriteRule (^|/)\.git(/|$) - [F]

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /prolynweb/p/

    # assets -> dist/assets
    RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

    # Temiz URL: .php ile biten SORGUSUZ GET isteklerini uzantısıza (302)
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{QUERY_STRING} ^$
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=302,L]

    # Mevcut dosya/klasörse dokunma
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Uzantısız -> .php  (REQUEST_FILENAME mutlak; RewriteBase'den bağımsız çalışır)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L]
</IfModule>
